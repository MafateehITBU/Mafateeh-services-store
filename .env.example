# Server-only. Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mafateeh_store?schema=public"

# Public. Leave empty to hide the floating WhatsApp button.
NEXT_PUBLIC_WHATSAPP_URL=

# Reserved for future customer email codes. Administrator sign-in does not use SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Signs the administrator session cookie. Use at least 32 random characters. Never prefix with NEXT_PUBLIC_.
SESSION_SECRET=

# Used only by `npm run admin:bootstrap`. These are not read by the web application.
# The password must be at least 12 characters. Do not commit a real password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
